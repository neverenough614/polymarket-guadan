[Unit]
Description=predict.fun live (place / monitor / defense / auto-close / rotation)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/root/poly-maker
# 不带 --limit → 用代码里的 DEFAULT_MARKET_LIMIT（当前 8，与本地一致）。
# 想改市场数：改 scripts/predictfun_run.py 的 DEFAULT_MARKET_LIMIT 后 git pull + 重启；
# 或在此行末尾加 --limit N 临时覆盖。
ExecStart=/root/poly-maker/.venv/bin/python scripts/predictfun_run.py live
Restart=on-failure
RestartSec=15
# 关键：停止时发 SIGINT（=Ctrl+C），触发代码里的"撤光所有单 + 收尾清仓"，
# 否则 systemd 默认 SIGTERM 会直接杀进程、留下未撤挂单。给足清仓时间。
KillSignal=SIGINT
TimeoutStopSec=120
StandardOutput=append:/var/log/predictfun-live.log
StandardError=append:/var/log/predictfun-live.log

[Install]
WantedBy=multi-user.target
