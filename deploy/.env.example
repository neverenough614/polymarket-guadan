# predict.fun VPS 环境变量模板。复制为 .env 并在服务器上填真值。
# ⚠️ 私钥只在服务器上填，绝不提交、绝不发给任何人。.env 已在 .gitignore。

PLATFORM=predictfun
PREDICTFUN_NETWORK=mainnet

# 你的 EOA 签名私钥（0x 开头）。仅本机签名用，绝不外传。
PREDICTFUN_PK=

# predict.fun API key
PREDICTFUN_API_KEY=

# 你的 ZeroDev 智能账户地址（持仓账户，0x 开头）
PREDICTFUN_ACCOUNT=

# Google 表格 URL（与 Polymarket 同一套表，predict.fun 用专属标签页）
SPREADSHEET_URL=

# 另需把 Google 服务账号 credentials.json 放到仓库根目录（scp 上传，勿提交）
